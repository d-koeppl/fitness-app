# app/ has its own .gitignore from `flutter create`.

# Python (functions/)
functions/venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Secrets and local overrides — never committed
.env
.env.*
!.env.example
*.local
service-account*.json
*.key

# Database dumps for the migration dry runs hold real health data
*.sql
*.sql.gz
*.dump
backup-*

# Firebase CLI and emulators
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
ui-debug.log
pubsub-debug.log

# Editors and OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
