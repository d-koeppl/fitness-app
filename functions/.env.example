# Copy to .env.fitness-75c22 for deploys (read by `firebase deploy`), or to
# .env.local for the emulators. Neither copy is committed.

# The Google accounts allowed to use the API, as a JSON list (ADR-029).
# Empty or unset locks everyone out.
ALLOWED_EMAILS=["you@gmail.com"]

# Which calendars the sync reads (comma-separated), and where Google sends
# the browser back after a Calendar/Health consent.
GOOGLE_CALENDAR_IDS=primary
GOOGLE_REDIRECT_URI=https://europe-west1-<project-id>.cloudfunctions.net/api/oauth/google/callback

# The ÖFB scrape. Unset, it is skipped.
OEFB_PLAYER_NAME=
OEFB_TEAM_URL=
OEFB_SEASON=

# Secrets do NOT go here: TOKEN_ENCRYPTION_KEY, GOOGLE_CLIENT_ID and
# GOOGLE_CLIENT_SECRET live in Secret Manager
# (`firebase functions:secrets:set NAME --data-file -`).
