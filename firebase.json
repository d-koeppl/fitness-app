{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python313",
      "ignore": ["venv", ".venv", "tests", "tools", ".pytest_cache", ".ruff_cache", "__pycache__", "*.local", ".env"]
    }
  ],
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "app/build/web",
    "predeploy": ["cd app && dart run tool/build_web.dart"],
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [{ "source": "!/.well-known/**", "destination": "/index.html" }]
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": { "port": 9099 },
    "functions": { "port": 5001 },
    "firestore": { "port": 8080 },
    "hosting": { "port": 5000 },
    "ui": { "enabled": true, "port": 4000 }
  }
}
